# Base URL of the SIA API.
#
# Copy this file to `.env` and fill in the value. Expo loads `.env` automatically
# and inlines every EXPO_PUBLIC_* variable into the bundle at build time — so a
# change here requires a restart (`npx expo start -c`), not just a reload.
#
# Which URL to use:
#   web on this machine ........ http://localhost:3000
#   Android emulator ............ http://10.0.2.2:3000
#   physical phone on same Wi-Fi  http://192.168.x.x:3000
#   deployed backend ............ https://your-service.onrender.com
#
# Never leave this empty: an empty value falls back to http://localhost:3000,
# which silently breaks the app on a real device.
EXPO_PUBLIC_API_URL=http://localhost:3000
